<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
     <style>
                body {
                    background-color: white;
                    font-family: Calibri, 'Trebuchet MS', sans-serif;
                    font-size: 16px;
                }
                nav {
                    background-color: #95b808 ;
                    padding: 0.5em 0;
                    font-size: 24px;
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
                }
                nav ul {
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    display: flex;
                    gap: 2em;
                    justify-content: center;
                }
                nav li {
                    display: inline;
                }
                nav a {
                    color: #fff;
                    text-decoration: none;
                    font-family: 'MT Gill Sans Bold', 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
                    font-weight: bold;
                    font-size: 1.1em;
                    padding: 0.5em 1em;
                    transition: background 0.2s;
                    border-radius: 4px;
                }
                nav a:hover {
                    background: #444;
                }

/*Services*/

 .services {
    text-align: center;
    margin: 50px 0;
}
.services h3,h2 {
    font-family: "Gill Sans MT", "Gill Sans", "Gill Sans MT Bold", sans-serif;
    font-weight: bold;

}
.services p{
    font-family: "Calibri", sans-serif;
font-weight: normal;
}

.services-container {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
}

.service-box {
    flex: 1 1 250px;
    max-width: 300px;
    padding: 20px;
    border: 2px solid #f0c040;
    border-radius: 10px;
    background: #fffbea;
    box-shadow: 2px 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s;
}

.service-box:hover {
    transform: translateY(-5px);
}   

.nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2em;
}

.logo img {
    height: 50px; /* Adjust as needed */
    width: auto;
}

nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2em;
}

            </style>
    <body>
 <nav>
    <div class="nav-container">
        <div class="logo">
                <img src="/images/Anita's_Fresh_Delights.png" alt="Logo">
        </div>
        <ul>
            <li><a href="/home">HOME</a></li>
            <li><a href="/products">PRODUCTS</a></li>
            <li><a href="/contacts">CONTACTS</a></li>
            <li><a href="/about">ABOUT</a></li>
        </ul>
    </div>
</nav>

        {% block body %}
        
        {% endblock %}
    </body>
</html>
