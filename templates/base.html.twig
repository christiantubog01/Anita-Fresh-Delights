<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}


    </head>
<style>
body {
    background-color: white;
    font-family: Calibri, 'Trebuchet MS', sans-serif;
    font-size: 16px;
}

/* NAVIGATION BAR */
nav {
    background-color: #95b808;
    padding: 0.5em 0;
    font-size: 24px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2em;
    justify-content: center;
}

nav li {
    display: inline;
}

nav a {
    color: #fff;
    text-decoration: none;
    font-family: 'MT Gill Sans Bold', 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    font-weight: bold;
    font-size: 1.1em;
    padding: 0.5em 1em;
    transition: background 0.2s;
    border-radius: 4px;
}

nav a:hover { 
    text-decoration: none;
    background: #444;
}

/* NAV LOGO */
.nav-container {
  display: flex;
  align-items: center;
  justify-content: flex-start; /* keep items grouped left */
  gap: 3em;
  padding-left: 2em;
}

.logo img {
    height: 50px;
    width: auto;
}

/* FOOTER */
.footer {
    background: #d5d5d5;
    color: #000000;
    padding: 40px 20px 20px;
    font-family: "Calibri", sans-serif;
}

.footer-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 30px;
    max-width: 1200px;
    margin: auto;
}

.footer-section {
    flex: 1 1 300px;
}

.footer-section h3,
.footer-section h4 {
    color: #000000;
    margin-bottom: 15px;
}

.footer-bottom {
    text-align: center;
    margin-top: 30px;
    border-top: 1px solid #555;
    padding-top: 15px;
    font-size: 14px;
    color: #000000;
}

</style>   
    <body>
  <nav>
    <div class="nav-container">
        <div class="logo">
                <img src="/images/Anita's_Fresh_Delights.png" alt="Logo">
        </div>
        <ul>
            <li><a href="/home">HOME</a></li>
            <li><a href="/all_products">PRODUCTS</a></li>
            <li><a href="/contacts">CONTACTS</a></li>
            <li><a href="/about">ABOUT</a></li>
        </ul>
    </div>
</nav>
        {% block body %}
<!-- ENTERY -->
        {% endblock %}

<!-- Footer -->
 <footer class="footer">
    <div class="footer-container">
        <div class="footer-section">
            <h3>Anita's Fresh Delights</h3>
            <p>Authentic Filipino food with a modern twist. Fresh, delicious, and made with love.</p>
        </div>

        <div class="footer-section">
            <h4>Contact</h4>
            <p>Email: info@anitasfreshdelights.com</p>
            <p>Phone: +63 912 345 6789</p>
            <p>Address:  Zone 2, Candau-ay, Dumaguete City</p>
        </div>
    </div>

    <div class="footer-bottom">
        <p>&copy; 2025 Anita's Fresh Delights | All Rights Reserved</p>
    </div>
</footer>

    </body>
</html>
