<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            display: flex;
            font-size: 16px;
        }

        /* Sidebar */
        .sidebar {
            position: sticky; 
            top: 0;
            height: 100vh;
            width: 200px;
            background-color: rgba(48, 48, 48, 1);
            color: white;
            padding: 20px;
            box-shadow: 5px 0px 10px #000000;
            display: flex;
            flex-direction: column;
        }

 @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
  }
        .sidebar .logo {
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar .logo img {
            background-color: white;
            display: block;
            margin: 0 auto;
            width: 80px;
            height: auto;
            border-radius: 100px;
            box-shadow: 0px 0px 10px #ffffffff;
        }

        .sidebar h2 {
            user-select: none;
            cursor: default;
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 20px;
            text-align: center;
            border-bottom: 1px solid #444;
            padding-bottom: 10px;
            font-family: 'Gill Sans MT', sans-serif;
        }
        .sidebar h2:hover {
            text-shadow: 0 0 5px #ffffffc8;
        }

        .sidebar button {
            display: block;
            width: 100%;
            margin: 10px 0;
            padding: 10px;
            border: none;
            background-color: #565656ff;
            color: rgb(255, 255, 255);
            font-size: 16px;
            cursor: pointer;
            text-align: left;
            border-radius: 4px;
            transition: background 0.3s;
            box-shadow: 5px 5px 5px #000000;
        }

        .sidebar button:hover {
            background-color: #868686ff;
            box-shadow: 0px 0px 5px #ffffffc8;
        }

        .content {
            flex: 1;
            padding: 20px;
        }

        /* ✅ User Profile Section */
        .user-profile {
            position: absolute;  /* Stick to bottom of sidebar */
            bottom: 20px;        /* Distance from bottom */
            left: 20px;
            right: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: #00000055;
            padding: 10px;
            border-radius: 8px;
        }

        .profile-pic {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid white;
            object-fit: cover;
        }

        .user-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .user-name {
            font-size: 14px;
            font-weight: bold;
            color: #fff;
        }

        .logout-btn {
            font-size: 12px;
            color: #ffffffff;
            text-decoration: none;
        }

        .logout-btn:hover {
            color: #ff0000ff;
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <!-- Logo Section -->
        <div class="logo">
            <img src="/images/logo.png" alt="Logo">
        </div>

        <!-- Sidebar Links -->
        <h2>DASHBOARD</h2>
        <a href="/"><button>Home</button></a>
        <a href="/dashboard/users"><button>Users</button></a>
        <a href="/dashboard/roles"><button>Roles</button></a>
        <a href="/dashboard/products"><button>Products</button></a>
        <a href="/dashboard/category"><button>Category</button></a>
        <a href="/dashboard/reports"><button>Reports</button></a>

        <!-- ✅ User Profile at Bottom -->
        <div class="user-profile">
          <img src="/images/default-profile.jpg" alt="User" class="profile-pic">
            <div class="user-info">
                <span class="user-name">Admin User</span>
                <a href="/home" class="logout-btn">Logout</a>
            </div>
        </div>
    </div>

    {% block body %}
    {% endblock %}
</body>
</html>
