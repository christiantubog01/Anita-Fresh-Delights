{% extends 'dashboard.html.twig' %}

{% block title %}Reports{% endblock %}

{% block body %}
<style>
body {
    background: linear-gradient(to bottom, #000942ff, #0080ffff);
    min-height: 100vh;
    margin: 0;
    font-family: "Gill Sans MT", sans-serif;
}

.reports-container {
    max-width: 900px;
    margin: 80px auto;
    color: #fff;
    text-align: center;
}

.page-title {
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 30px;
}

.card-grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
    margin-bottom: 50px;
}

.report-card {
    background: #000000cc;
    border: 2px solid #000000;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    padding: 30px;
    width: 250px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.report-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(255,255,255,0.2);
}

.report-title {
    font-size: 20px;
    margin-bottom: 10px;
    color: #00ad23ff;
}

.report-value {
    font-size: 36px;
    font-weight: bold;
    color: #ffffff;
}

.chart-container {
    background: #000000aa;
    border-radius: 10px;
    padding: 30px;
    max-width: 500px;
    margin: 0 auto;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}
</style>

<div class="reports-container">
    <h1 class="page-title">REPORTS OVERVIEW</h1>

    <div class="card-grid">
        <div class="report-card">
            <div class="report-title">Total Categories</div>
            <div class="report-value">{{ totalCategories }}</div>
        </div>

        <div class="report-card">
            <div class="report-title">Total Products</div>
            <div class="report-value">{{ totalProducts }}</div>
        </div>
    </div>

    <div class="chart-container">
        <canvas id="reportPieChart"></canvas>
    </div>
</div>

<!-- ✅ Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('reportPieChart');

new Chart(ctx, {
    type: 'pie',
    data: {
        labels: ['Categories', 'Products'],
        datasets: [{
            label: 'Distribution',
            data: [{{ totalCategories }}, {{ totalProducts }}],
            backgroundColor: ['#00ad23ff', '#00bfff'],
            borderColor: '#fff',
            borderWidth: 2
        }]
    },
    options: {
        plugins: {
            legend: {
                labels: {
                    color: 'white',
                    font: { size: 14 }
                }
            }
        }
    }
});
</script>
{% endblock %}
